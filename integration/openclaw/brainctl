#!/usr/bin/env bash
# brainctl - operator CLI for the diagnostic Brain (ADR-0011, SPEC section 14).
# Wraps the Brain HTTP API only; needs curl (python3 optional, for pretty JSON).
set -u -o pipefail

BRAIN_URL="${BRAIN_URL:-http://127.0.0.1:8000}"

usage() {
  cat <<'EOF'
usage: brainctl <command> [args]

  health                        Brain + Ollama status
  bundles                       list bundles known to the inbox
  usb [source]                  receive bundles from a plugged-in client stick
                                (default: auto-discover mounted sticks)
  diagnose [bundle_id...]       start a run (default: all unused ready bundles)
           [-q "question"] [--full | --no-full]   full-context injection
                                (default: auto - on for usb-received bundles)
  runs                          list runs with status
  watch <run_id>                follow the live event stream, print the trail
  report <run_id>               print the finished report markdown
EOF
  exit 2
}

pretty() {
  if command -v python3 >/dev/null 2>&1; then python3 -m json.tool 2>/dev/null || cat; else cat; fi
}

api() { curl -sf "${BRAIN_URL}/api/$1" "${@:2}"; }

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  health)
    api healthz | pretty
    ;;
  bundles)
    api bundles | pretty
    ;;
  runs)
    api runs | pretty
    ;;
  usb)
    if [ $# -ge 1 ]; then
      body="{\"source\": \"$1\"}"
    else
      body="{}"
    fi
    api usb/receive -X POST -H 'Content-Type: application/json' -d "$body" | pretty
    ;;
  diagnose)
    question="Diagnose the collected machines: find the root cause of any failure and propose a fix."
    ids=()
    full=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -q) question="$2"; shift 2 ;;
        --full) full="true"; shift ;;
        --no-full) full="false"; shift ;;
        *) ids+=("$1"); shift ;;
      esac
    done
    body="{\"question\": \"${question}\""
    if [ ${#ids[@]} -gt 0 ]; then
      id_json=$(printf '"%s",' "${ids[@]}")
      body="${body}, \"bundle_ids\": [${id_json%,}]"
    fi
    if [ -n "$full" ]; then
      body="${body}, \"full_context\": ${full}"
    fi
    body="${body}}"
    api runs -X POST -H 'Content-Type: application/json' -d "$body" | pretty
    ;;
  watch)
    [ $# -ge 1 ] || usage
    # print the reasoning trail: status/query/chunk/graph/done/error events
    curl -sN "${BRAIN_URL}/api/runs/$1/stream" | while IFS= read -r line; do
      case "$line" in
        event:*) ev="${line#event: }" ;;
        data:*)
          data="${line#data: }"
          case "${ev:-}" in
            token) ;; # skip the token firehose; the report command prints it whole
            done) echo "[done] ${data}"; break ;;
            error) echo "[error] ${data}"; break ;;
            *) echo "[${ev:-?}] ${data}" ;;
          esac
          ;;
      esac
    done
    ;;
  report)
    [ $# -ge 1 ] || usage
    if command -v python3 >/dev/null 2>&1; then
      api "runs/$1" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("report_markdown") or "run status: " + d["status"] + ((" (" + str(d.get("error")) + ")") if d.get("error") else ""))'
    else
      api "runs/$1"
    fi
    ;;
  *) usage ;;
esac
