# clinic-backend configuration
# Deployed to /etc/clinic/backend.env and loaded by systemd (EnvironmentFile=).
# This is the file inject.sh edits and the file collector.sh captures.

SERVICE_NAME=clinic-backend
SERVICE_VERSION=2.4.1

BIND=0.0.0.0
PORT=8080

# Records database. DB_HOST is the value the whole scenario turns on.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_TIMEOUT_MS=3000

# Retired addressing from the pre-2025 records host. Retained for the CLIN-2988
# migration rollback path. Not read by any current code path.
DB_HOST_LEGACY=10.0.4.7
DB_PORT_LEGACY=5432

# Async records rollout (CLIN-3117), paused pending CLIN-3204.
# Leave disabled. Enabling it routes lookups through backend/pool.js.
FEATURE_ASYNC_RECORDS=false
DB_POOL_MAX=8
DB_POOL_IDLE_MS=30000
DB_POOL_REAP_MS=5000

# Records service accepts plaintext on the clinic VLAN; this certificate is
# provisioned but not currently presented.
TLS_CERT_PATH=/etc/clinic/tls/records.pem

# Record cache is off pending the capacity review.
CACHE_TTL_SECONDS=0

LOG_FILE=/var/log/clinic/backend.log
LOG_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_MS=45000
