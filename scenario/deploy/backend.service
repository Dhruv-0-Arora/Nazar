[Unit]
Description=Acme scenario backend (the patient)
After=network.target mock-db.service
Wants=mock-db.service

[Service]
Type=simple
WorkingDirectory=/opt/myapp/backend
Environment=ENV_FILE=/etc/myapp/backend.env
ExecStart=/usr/bin/env node /opt/myapp/backend/server.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
